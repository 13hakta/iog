{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ioga",
            "args": ["config-server.ini"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "environment": [],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Launch client",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ioga",
            "args": ["config-client.ini"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "environment": [],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
